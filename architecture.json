  "api": [
    {
      "method": "POST",
      "path": "/api/enroll",
      "req": "{ username, passcode }",
      "res": "200 / 409 登録済み / 422 弱い配置 / 413 過大",
      "desc": "新規登録のみ。上書き不可"
    },
    {
      "method": "POST",
      "path": "/api/reenroll",
      "req": "{ username, passcode } + Bearer",
      "res": "200 / 401 / 403 / 422",
      "desc": "本人のみパスコード変更。旧セッションは失効"
    },
    {
      "method": "POST",
      "path": "/api/authenticate",
      "req": "{ username, passcode }",
      "res": "200 {session} / 401 / 429 / 503",
      "desc": "サーバー側で照合しセッション発行"
    },
    {
      "method": "POST",
      "path": "/api/forget",
      "req": "{ username } + Bearer",
      "res": "200 / 401 / 403",
      "desc": "本人のみ登録削除"
    },
    {
      "method": "POST",
      "path": "/api/logout",
      "req": "Bearer",
      "res": "200",
      "desc": "セッション失効"
    },
    {
      "method": "GET",
      "path": "/api/me",
      "req": "Bearer",
      "res": "200 {username}",
      "desc": "セッションの持ち主"
    }
  ],
  "flows": [
    {
      "id": "enroll",
      "title": "登録フロー (ENROLL)",
      "steps": [
        {
          "actor": "利用者",
          "text": "6面×2箇所をタッチして選ぶ"
        },
        {
          "actor": "ブラウザ",
          "text": "[[c,c]×6] を /api/enroll へ送信"
        },
        {
          "actor": "サーバー",
          "text": "本文サイズ・型・形式を検証し正規化"
        },
        {
          "actor": "サーバー",
          "text": "既知の弱い規則に該当しないか検査（bit値は返さない）"
        },
        {
          "actor": "サーバー",
          "text": "既存ユーザーなら409。新規のみArgon2idで保存"
        },
        {
          "actor": "ブラウザ",
          "text": "認証モードへ切り替え"
        }
      ]
    },
    {
      "id": "auth",
      "title": "認証フロー (AUTHENTICATE)",
      "steps": [
        {
          "actor": "利用者",
          "text": "登録した12箇所を入力"
        },
        {
          "actor": "ブラウザ",
          "text": "配置を /api/authenticate へ送信"
        },
        {
          "actor": "サーバー",
          "text": "IP制限を確認し、試行枠を原子的に1つ消費"
        },
        {
          "actor": "サーバー",
          "text": "ロック中なら同じ計算時間を使って一律に拒否"
        },
        {
          "actor": "サーバー",
          "text": "Argon2id.verify で照合（同時実行数を制限）"
        },
        {
          "actor": "ブラウザ",
          "text": "成功時セッショントークンを受領"
        }
      ]
    }
  ],
